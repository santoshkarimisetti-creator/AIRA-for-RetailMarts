# =============================================================================
# AIRA — Backend Environment Configuration (.env)
# =============================================================================

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aira_db

# Local Ollama AI Engine (100% Offline Local Inference)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Security & Authentication
JWT_SECRET=aira_supermarket_secret_jwt_key_2026_retail_os
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Store Configuration
STORE_NAME=AIRA Retail Mart
STORE_CURRENCY=INR
STORE_TIMEZONE=Asia/Kolkata

# Server Configuration
PORT=8000
ENVIRONMENT=development
