# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aira_db

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Store Configuration
STORE_NAME=AIRA Retail Mart
STORE_CURRENCY=INR
STORE_TIMEZONE=UTC

# Server Configuration
PORT=8000
ENVIRONMENT=development

# AIRA Assistant Configuration (Optional Open-Source LLM e.g. Ollama)
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3:latest

# Notifications (Optional)
FAST2SMS_API_KEY=
SMTP_USER=
SMTP_PASSWORD=
